# Edge Function secrets. Copy to supabase/.env.local (git-ignored), fill in, then upload with:
#   npx supabase secrets set --env-file supabase/.env.local
# Never commit real values. SUPABASE_URL and the Supabase keys are provided automatically.

# Google AI Studio API key for the AI coach (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Shared secret the hourly pg_cron job sends to coach-scheduler; store the same value in Vault
# as `coach_cron_secret` (see README → AI coach). Use a long random string.
COACH_CRON_SECRET=

# Optional overrides.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# COACH_GLOBAL_DAILY_LIMIT=2000
# EXPO_ACCESS_TOKEN=
