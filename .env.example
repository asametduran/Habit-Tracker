# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
# Use the publishable key only. The secret (service_role) key must never be in the app or the repo.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Cloudflare Turnstile CAPTCHA on sign-in, sign-up and password reset (README →
# Security settings). Site keys are public by design. Leave unset until you have a widget.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# Phones only: the https URL their CAPTCHA page claims to come from; its hostname must be one of
# the widget's hostnames. Defaults to EXPO_PUBLIC_SUPABASE_URL.
# EXPO_PUBLIC_TURNSTILE_PAGE_URL=https://your-domain.example
